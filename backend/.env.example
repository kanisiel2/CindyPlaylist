# App
NODE_ENV=development
PORT=3000

# Database (MariaDB)
DATABASE_URL="mysql://cindy:password@localhost:3306/cindy_playlist"

# YouTube API
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback
YOUTUBE_PLAYLIST_ID=your_playlist_id

# OAuth (example placeholders)
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret
OAUTH_KAKAO_CLIENT_ID=your_kakao_client_id
OAUTH_KAKAO_CLIENT_SECRET=your_kakao_client_secret
OAUTH_NAVER_CLIENT_ID=your_naver_client_id
OAUTH_NAVER_CLIENT_SECRET=your_naver_client_secret
